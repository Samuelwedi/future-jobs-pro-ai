{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "private-device-test": {
      "environment": "preview",
      "distribution": "store",
      "env": { "EXPO_PUBLIC_FJ_PRIVATE_TEST": "1", "EXPO_NO_DOTENV": "1" },
      "ios": { "autoIncrement": true },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "production": {
      "ios": {
        "distribution": "store",
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "closed-test": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6776965870"
      }
    }
  }
}
