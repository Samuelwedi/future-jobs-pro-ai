index 0000000..4ca32d4
--- /dev/null
+++ b/node_modules/braces/lib/depth-guard.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm; do not recurse on unbounded ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 64 || ++count > 100000) {
+      throw new SyntaxError('Brace AST exceeds safe depth or size');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
